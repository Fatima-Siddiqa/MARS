# Copy to .env and fill in. NEVER commit .env.

APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Database (matches docker-compose.yml) ---
POSTGRES_USER=mars
POSTGRES_PASSWORD=mars
POSTGRES_DB=mars
DATABASE_URL=postgresql+psycopg://mars:mars@localhost:5432/mars

# --- LLM: choose ONE provider (ollama | groq) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Data sources (add keys as agents need them) ---
# SBP / World Bank / GDELT are keyless; add other keys below if required
