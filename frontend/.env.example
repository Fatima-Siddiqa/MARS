# Copy to .env.local (never commit). NEXT_PUBLIC_* values are baked in at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Other agents are still mocked until their backends exist.
NEXT_PUBLIC_USE_MOCK=true
# Technical agent is LIVE by default; set true to mock it (frontend-only work).
NEXT_PUBLIC_USE_MOCK_TECHNICAL=false
# Raw price files end in July 2026; pin the analysis date so data is not "stale" (optional).
NEXT_PUBLIC_TECH_AS_OF=2026-07-14
